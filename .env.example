DASHSCOPE_API_KEY=your_dashscope_api_key_here
# 改为 1 才会跑 tests/test_dashscope_eval_integration.py 里的真实 API 调用
RUN_DASHSCOPE_LIVE=0
# Optional: e.g. https://dashscope-intl.aliyuncs.com/api/v1
DASHSCOPE_BASE_URL=
# 模型建议在命令行显式传 --model，默认 qwen3-vl-8b-thinking

# 本地 OpenAI 兼容 VLLM（MLLMConfig 默认 api_provider=vllm）
# VLLM_OPENAI_BASE_URL=http://localhost:8201/v1
# VLLM_API_KEY=not-needed
