# =============================================================================
# AIGC 视频合理性评测 — VLM / MLLM 环境配置模板
# =============================================================================
# 复制本文件为 .env 并按需修改:
#   cp .env.example .env
#
# 完整变量说明见 .env 文件中的注释。

# ==================== API Key / Endpoint ====================

DASHSCOPE_API_KEY=your_dashscope_api_key_here
# DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/api/v1

# VLLM_OPENAI_BASE_URL=http://localhost:8201/v1
# VLLM_API_KEY=not-needed

# ==================== MLLM 通用配置 ====================

# MLLM_PROVIDER=vllm
# MLLM_MODEL=qwen3.5:9b
# MLLM_FPS=2
# MLLM_BACKEND=api

# ==================== VLLM 专用 ====================

# MLLM_VLLM_MAX_FRAMES=5
# MLLM_TIMEOUT=300

# ==================== 通用 MLLM 调参 ====================

# MLLM_TEMPERATURE=0.1
# MLLM_MAX_FRAMES=16

# ==================== 运行开关 ====================

# 设为 1 才会在 tests/ 中执行真实的 DashScope API 调用（test_dashscope_eval_integration.py）
# RUN_DASHSCOPE_LIVE=0
